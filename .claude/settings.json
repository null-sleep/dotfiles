      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git clone *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)",

      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh search *)",
      "Bash(gh auth *)",

      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew install *)",
      "Bash(brew bundle *)",
      "Bash(brew tap *)",
      "Bash(brew help *)",
      "Bash(brew commands *)",

      "Bash(nvim --headless *)",
      "Bash(nvim -es *)",
      "Bash(env -u NVIM *)",
      "Bash(pkill -f *)",

      "Bash(stow *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(ln -s *)",
      "Bash(ln -sfn *)",
      "Bash(chmod *)",

      "Bash(bash *)",
      "Bash(zsh -c *)",
      "Bash(zsh -ic *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",

      "Bash(bash -n *)",
      "Bash(zsh -n *)",
      "Bash(luac -p *)",
      "Bash(luac5.1 -p *)",
      "Bash(shellcheck *)",
      "Bash(awk *)",

      "Bash(command -v *)",
      "Bash(curl -s *)",
      "Bash(curl -fsSL *)",
      "Bash(rustup toolchain *)",

      "Bash(claude-nvim check *)",
      "Bash(claude-nvim lua *)",
      "Bash(theme status *)",

      "Bash(rtk git *)",
      "Bash(rtk nvim *)",
      "Bash(rtk proxy *)",
      "Bash(rtk grep *)",
      "Bash(rtk find *)",
      "Bash(rtk rg *)",
      "Bash(rtk ls *)",
      "Bash(rtk wc *)",
      "Bash(rtk diff *)",
      "Bash(rtk ps *)",
      "Bash(rtk gain *)",
      "Bash(rtk read *)",
      "Bash(rtk du *)",
      "Bash(rtk init *)",
      "Bash(rtk gh *)",
      "Bash(rtk cargo *)",
      "Bash(rtk pip *)",
      "Bash(rtk curl *)",

      "Bash(plutil -p *)",
      "Bash(plutil -lint *)",
      "Bash(plutil -extract *)",
      "Bash(defaults read *)",

      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "Skill(deep-research)",
      "Skill(update-config)",
      "Skill(fewer-permission-prompts)",
      "Artifact"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | { read -r cmd; is_nvim=0; for tok in $cmd; do if [ \"$tok\" = \"nvim\" ]; then is_nvim=1; fi; done; if [ \"$is_nvim\" = \"1\" ] && ! printf '%s' \"$cmd\" | grep -q 'env -u NVIM'; then jq -n '{hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"nvim invoked without env -u NVIM. This repos flatten.nvim would route it into the users live nvim instance via $NVIM instead of an isolated one (see nvim/.config/nvim/CLAUDE.md). Re-issue with env -u NVIM prefixed.\"}}'; fi; }",
            "statusMessage": "Checking nvim invocation for flatten.nvim safety..."
          }
        ]
      }
    ]
  }
}
