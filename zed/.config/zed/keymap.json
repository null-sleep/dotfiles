    // Toggle vim mode. Zed has no default key (palette: "workspace: toggle vim
    // mode"). Workspace context so it works with vim on or off. Rewrites
    // settings.json's vim_mode; Terminal has its own cmd-k (terminal::Clear),
    // so the chord does not fire there.
    {
        "context": "Workspace",
        "bindings": {
            "cmd-k cmd-v": "workspace::ToggleVimMode"
        }
    },
    // Open cheatsheet.md via the "cheatsheet" task in tasks.json. Shadows Zed's
    // default toolchain::AddToolchain; like cmd-k cmd-v, doesn't fire with a
    // terminal focused (cmd-k clears the terminal).
    {
        "context": "Workspace",
        "bindings": {
            "cmd-k cmd-m": ["task::Spawn", { "task_name": "cheatsheet" }]
        }
    }
]
