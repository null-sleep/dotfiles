// Zed keymap — stowed to ~/.config/zed/keymap.json (see README → "Zed").
// Nearly empty while learning Zed's native keys. The vim-mode bindings to
// carry over from nvim, with a block to paste, live in
// docs/zed-vim-keymap.md; adopt rows from there. nvim keymaps live in
// GUIDE.md.
[
    // Swap the floating text finder and editable project-search tab shortcuts.
    // Unscoped bindings override the defaults in editors and search bars alike.
    {
        "use_key_equivalents": true,
        "bindings": {
            "cmd-shift-f": "text_finder::Toggle",
            "alt-cmd-f": "pane::DeploySearch"
        }
    },
    // Step through agent threads in sidebar order. Zed has no default key for
    // this; ctrl-tab opens the MRU switcher instead. Scoped to the agent panel
    // and threads sidebar so alt-] / alt-[ still type normally in editors.
    {
        "context": "AgentPanel || ThreadsSidebar",
        "bindings": {
            "alt-]": "multi_workspace::NextThread",
            "alt-[": "multi_workspace::PreviousThread"
        }
    },
    // Toggle vim mode. Zed has no default key (palette: "workspace: toggle vim
    // mode"). Workspace context so it works with vim on or off. Rewrites
    // settings.json's vim_mode; Terminal has its own cmd-k (terminal::Clear),
    // so the chord does not fire there.
    {
        "context": "Workspace",
        "bindings": {
            "cmd-k cmd-v": "workspace::ToggleVimMode"
        }
    },
    // Open cheatsheet.md via the "cheatsheet" task in tasks.json. Shadows Zed's
    // default toolchain::AddToolchain; like cmd-k cmd-v, doesn't fire with a
    // terminal focused (cmd-k clears the terminal).
    {
        "context": "Workspace",
        "bindings": {
            "cmd-k cmd-m": ["task::Spawn", { "task_name": "cheatsheet" }]
        }
    }
]
