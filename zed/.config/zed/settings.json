// Zed settings — stowed to ~/.config/zed/settings.json (see README → "Zed").
// Zed rewrites this file when you change settings in its UI, so review
// `git diff zed/` after UI tweaks. Defaults: `zed: open default settings`.
{
    "minimap": {
        "show": "never"
    },
    "which_key": {
        "enabled": true
    },
    "window_title_separator": " — ",
    "preview_tabs": {
        "enable_preview_from_multibuffer": false,
        "enable_preview_from_file_finder": true
    },
    "tabs": {
        "show_close_button": "hover",
        "git_status": true,
        "file_icons": false
    },
    "title_bar": {
        "show_menus": false,
        "show_user_picture": true,
        "show_branch_status_icon": false
    },
    "git_panel": {
        "show_count_badge": false,
        "folder_indicator": "chevron",
        "file_icons": false,
        "tree_view": false,
        "status_style": "icon"
    },
    "outline_panel": {
        "multi_buffer_hide_symbols": false,
        "folder_indicator": "chevron"
    },
    "project_panel": {
        "hide_root": false,
        "git_status_indicator": true,
        "bold_folder_labels": false,
        "folder_indicator": "chevron"
    },
    "instrumentation": {
        "performance_profiler": {
            "enabled": false
        }
    },
    "proxy": "",
    "edit_predictions": {
        "allow_data_collection": "yes"
    },
    "base_keymap": "Zed",
    "vim_mode": false,
    "vim": {
        // nvim yanks to the system clipboard (y only); Zed's closest match.
        "use_system_clipboard": "on_yank",
    },

    // Fonts — same family as Ghostty/Neovide.
    // ui_font_size 15 (default 16) also scales chrome heights, which are
    // rem-based.
    "ui_font_size": 15,
    // Thinner tab bar / status bar. Options: compact (tightest spacing and
    // chrome heights) | default | comfortable (loosest). Spacing only; fonts
    // are unaffected. Off: still unstable in v1.28.1 (Zed warns elements may
    // break), and only the `unstable.` key works — bare "ui_density" is
    // silently ignored. Status: tracking issue
    // https://github.com/zed-industries/zed/issues/18078 — stable once
    // `ui_density` loses its `#[serde(rename = "unstable.ui_density")]` in
    // https://github.com/zed-industries/zed/blob/main/crates/settings_content/src/theme.rs
    // "unstable.ui_density": "compact",
    "buffer_font_family": "Hack Nerd Font Mono",
    "buffer_font_size": 15.0,
    // Agent panel (chat threads only; π terminal threads use terminal.*).
    // ui = reply text; buffer = message box, your messages, code blocks, and
    // reply line height (buffer × 1.75). Mono replies: sans looked cramped.
    // Zed defaults: ui 16 (.ZedSans), buffer 12 (.ZedMono). Docs example:
    // ui 15 Inter, buffer 12 Berkeley Mono. See plans/zed-agent-panel-fonts.md.
    "agent_ui_font_family": "Hack Nerd Font Mono",
    "agent_ui_font_size": 17,
    "agent_buffer_font_size": 15,

    // Open every .md as the rendered preview (replaces the editor tab), so
    // the cheatsheet task in tasks.json lands in preview.
    "markdown_preview": {
        "open_markdown_files_in_preview": true,
    },

    // Pinned dark; "system" follows macOS, which is in light mode.
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Dracula Solid",
    },
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },

    "terminal": {
        "show_count_badge": false,
        "toolbar": {
            "breadcrumbs": false
        },
        "max_scroll_history_lines": 20000,
        "font_size": 15.0,
        // Option acts as Alt/Meta in Zed's terminal (matches Ghostty's
        // `macos-option-as-alt`); without it `alt-o` types `ø` and omp's
        // `Alt+O` model picker never fires.
        "option_as_meta": true,
    },

    // Hide the Keep/Reject agent-review buttons in the editor toolbar.
    // The thread's "Reject All / Keep All" bar above the message box has
    // no setting; `alt-shift-y` keeps all. Review stays at ctrl-shift-r.
    "toolbar": {
        "agent_review": false,
    },

    // Autosave 1s after the last edit, like nvim's auto-save.nvim (1s
    // debounce). Keeps buffers clean so Zed reloads them when git or an agent
    // changes the file on disk; Zed never reloads a dirty buffer. Autosaves
    // under `after_delay` skip `format_on_save` (on by default for Go, Rust,
    // Elixir, Kotlin, ...). `cmd-s` still formats in those languages;
    // `cmd-k s` saves without formatting. omp's writes are formatted too;
    // see docs/zed.md → Gotchas.
    "autosave": { "after_delay": { "milliseconds": 1000 } },

    // Editing — mirrors nvim's configs.lua (tabstop 4, scrolloff 10,
    // sidescrolloff 8, absolute numbers). Disabled for now; uncomment to
    // enable.
    // "tab_size": 4,
    // "vertical_scroll_margin": 10,
    // "horizontal_scroll_margin": 8,
    // "show_whitespaces": "selection",

    // Every extension installed on the main machine, so a fresh machine gets
    // the same set on first launch (Zed has no extension sync; this map is the
    // mechanism). Language servers/grammars outside Zed's built-ins (Go, Rust,
    // TS, Python are built in), theme/icon packs ("Dracula Solid" is the daily
    // theme), and the Codebook spell checker (it fetches its own codebook-lsp
    // binary; no language_servers override needed while none are set below).
    // Add new extensions here, not only via the Extensions UI. IDs are the dir
    // names in ~/Library/Application Support/Zed/extensions/installed.
    //
    // Updates: Zed auto-updates every installed extension on startup, and all
    // of these are deliberately left unpinned. To pin one to its current
    // version, add `"auto_update_extensions": { "<id>": false }` (the
    // Extensions page's "Install Another Version…" does this too).
    "auto_install_extensions": {
        "catppuccin": true,
        "catppuccin-blur": true,
        "catppuccin-icons": true,
        "codebook": true,
        "colored-zed-icons-theme": true,
        "csv": true,
        "docker-compose": true,
        "dockerfile": true,
        "dracula": true,
        "elixir": true,
        "env": true,
        "git-firefly": true,
        "github-theme": true,
        "gosum": true,
        "graphql": true,
        "helm": true,
        "html": true,
        "ini": true,
        "jetbrains-themes": true,
        "jsonnet": true,
        "just": true,
        "kotlin": true,
        "latex": true,
        "log": true,
        "lua": true,
        "macos-classic": true,
        "make": true,
        "monospace-icon-theme": true,
        "nix": true,
        "nord": true,
        "nvim-nightfox": true,
        "one-dark-pro": true,
        "postgres-language-server": true,
        "proto": true,
        "python-requirements": true,
        "racket": true,
        "rose-pine-theme": true,
        "scheme": true,
        "solarized": true,
        "sql": true,
        "swift": true,
        "terraform": true,
        "tmux": true,
        "tokyo-night": true,
        "toml": true,
        "xml": true,
    },

    // Per-language overrides. Go and Rust spell out Zed's defaults (v1.28.1
    // assets/settings/default.json) as knobs to flip — note an explicit value
    // here beats the same key set globally.
    // Defaults drift; re-check before editing via `zed: open default settings`
    // (top-level keys + its "languages" block).
    // CODEBOOK: no language below sets `language_servers`, which is why the
    // Codebook spell checker (see auto_install_extensions) runs everywhere.
    // If you add `language_servers` to a language, end the list with "..."
    // (or add "codebook"), e.g. ["pyright", "ruff", "..."]; otherwise
    // Codebook silently stops for that language. See docs/zed.md → Gotchas.
    //
    // Other keys accepted per language:
    //   formatting   formatter, format_on_save, code_actions_on_format
    //   layout       tab_size, hard_tabs, soft_wrap, preferred_line_length,
    //                wrap_guides
    //   LSP          language_servers (["x", "!y", "..."]), enable_language_server,
    //                semantic_tokens ("off"), colorize_brackets (false)
    //   save         remove_trailing_whitespace_on_save, ensure_final_newline_on_save
    "languages": {
        "Go": {
            // Built-in Go defaults: format_on_save on, hard_tabs, organizeImports
            // on format.
            "inlay_hints": {
                "enabled": false,
                "show_type_hints": true,
                "show_parameter_hints": true,
                "show_other_hints": true,
            },
            "completions": { "words": "fallback", "lsp": true },
            "show_edit_predictions": true,
            // Task variables: none — go test/run need no config.
            "tasks": { "enabled": true, "prefer_lsp": true },
            "debuggers": ["Delve"],
        },
        "Rust": {
            // Built-in Rust default: format_on_save on (rustfmt).
            "inlay_hints": {
                "enabled": false,
                "show_type_hints": true,
                "show_parameter_hints": true,
                "show_other_hints": true,
            },
            "completions": { "words": "fallback", "lsp": true },
            "show_edit_predictions": true,
            // Task variables: RUST_DEFAULT_PACKAGE_RUN (cargo run -p <pkg>),
            // RUST_TARGET_DIR.
            "tasks": { "enabled": true, "prefer_lsp": true },
            "debuggers": ["CodeLLDB"],
        },
        "Python": {
            // Default runner is pytest, which isn't installed; stdlib unittest
            // needs nothing (fixtures/test_animal.py uses it).
            "tasks": { "variables": { "TEST_RUNNER": "unittest" } },
        },
    },

    "git": {
        "auto_fetch": { "enabled": false, "interval_secs": 60 },
    },
    // Reopen the last-closed workspace even if its window was closed before
    // quitting (the default "last_session" only restores windows still open
    // at quit).
    "restore_on_startup": "last_workspace",
    "session": {
        "trust_all_worktrees": true,
        "restore_unsaved_buffers": true,
    },

    // Hide in-repo git worktrees (`.worktrees/` from repo scripts,
    // `.claude/worktrees/` from Claude Code) from the main checkout's project
    // panel, file finder/search (even with ignored files shown), and Zed
    // Agent's file tools. Opening a worktree directly and the worktree picker
    // are unaffected. "..." keeps Zed's defaults. See docs/zed-worktrees.md.
    "file_scan_exclusions": ["...", "**/.worktrees", "**/.claude/worktrees"],

    "agent": {
        "terminal_init_command": "claude",
        "enable_feedback": false,
        // Off as a workaround (2026-11, Zed 1.28.1): auto-compaction of
        // Claude threads fails with "unknown variant `between_tools`,
        // expected one of `enabled`, `adaptive`, `disabled`" (Zed client vs
        // zed.dev server mismatch), and Retry repeats it. Manual compaction
        // likely hits it too. Cost: a long thread now fails at the context
        // limit instead, so start a new thread first. Re-enable after a Zed
        // update fixes it. See docs/zed.md → Agent panel.
        "auto_compact": {
            "enabled": false,
            "threshold": "70%"
        },
        "show_turn_stats": true,
        "message_editor_min_lines": 4,
        // Collapse thinking blocks (Zed Agent and ACP agents like omp);
        // click a block's header to expand it.
        "thinking_display": "always_collapsed",
        // Start new terminal-command and edit cards collapsed; click a card
        // to see its output or diff.
        "expand_terminal_card": false,
        "expand_edit_card": false,
        // omp-like: no sandbox approval prompts. Zed's OS sandbox never lets
        // terminal commands write .git metadata, so any narrower grant still
        // prompts on every `git commit`.
        "sandbox_permissions": {
            "allow_unsandboxed": true
        },
        // Zed rewrites this block (and omp's default_config_options.model
        // below) every time you pick a model, so a diff here is expected.
        // Commit it or leave it; never discard it (that silently resets
        // the model you picked).
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-5-5",
            "enable_thinking": true,
            "effort": "high"
        },
        // omp-like `yolo`: Zed Agent's built-in tools never prompt. Deny
        // rules block silently (no prompt); Zed's built-in `rm -rf /`, `~`,
        // `.` guards still apply. External ACP agents keep their own
        // permission mode — see docs/zed.md → Inside a thread.
        "tool_permissions": {
            "default": "allow",
            "tools": {
                "edit_file": {
                    "always_deny": [
                        { "pattern": "\\.env" },
                        { "pattern": "\\.(pem|key)$" }
                    ]
                }
            }
        },
        "threads_sidebar": {
            "default_width": 222.0,
        },
        // Latest-generation zed.dev models, pinned at the top of the model
        // selector and cycled with alt-tab. This pins, it doesn't filter:
        // Zed has no hide/allowlist setting (`hidden_models`, zed#52347, was
        // closed unmerged; `available_models` only adds). Starring a model
        // in the picker rewrites this list. See docs/zed.md → Agent panel.
        // TODO: add Gemini 4 Carbon once Zed hosts it (OpenRouter:
        // google/gemini-4-carbon); it supersedes Argon at the same price.
        "favorite_models": [
            { "provider": "zed.dev", "model": "claude-fable-5-1" },
            { "provider": "zed.dev", "model": "claude-opus-5-5" },
            { "provider": "zed.dev", "model": "claude-sonnet-5-5" },
            { "provider": "zed.dev", "model": "claude-haiku-4-5" },
            { "provider": "zed.dev", "model": "gpt-6-astra" },
            { "provider": "zed.dev", "model": "gpt-6.1-sol" },
            { "provider": "zed.dev", "model": "gpt-5.6-terra" },
            { "provider": "zed.dev", "model": "gpt-6-luna" },
            { "provider": "zed.dev", "model": "gemini-4-argon" },
            { "provider": "zed.dev", "model": "gemini-3.5-flash" }
        ],
        "model_parameters": [],
    },
    // MCP servers for Zed Agent; Zed also forwards these to ACP agents (omp,
    // Codex). Tabularis: read-only DB schema/query tools via the
    // ~/.local/bin/tabularis shim (see README → Tabularis → MCP integration).
    "context_servers": {
        "tabularis": { "command": "tabularis", "args": ["--mcp"] },
    },
    "agent_servers": {
        "codex-acp": { "type": "registry" },
        // `--approval-mode yolo`: omp's ACP mode asks before every bash call
        // unless yolo is set explicitly; the built-in default doesn't count.
        // `--config`: scopes the model dropdown to omp's role models; written
        // by omp/setup-settings.sh (omp acp crashes if the file is missing).
        "omp": {
            // Written by Zed when you pick a model in an omp thread; drift
            // is expected, commit or leave it, never discard (see
            // agent.default_model).
            "default_config_options": {
                "mode": "default",
                "model": "anthropic/claude-sonnet-5-5"
            },
            "type": "custom",
            "command": "/opt/homebrew/bin/omp",
            "args": ["acp", "--approval-mode", "yolo", "--config", "~/.omp/agent/zed-models.yml"]
        },
    },
}
