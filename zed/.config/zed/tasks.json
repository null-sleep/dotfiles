// Zed global tasks — stowed to ~/.config/zed/tasks.json (see README → "Zed").
[
    // Show cheatsheet.md in a pager in the center pane; `q` quits and the tab
    // closes. Bound to cmd-k cmd-m in keymap.json.
    {
        "label": "cheatsheet",
        "command": "less",
        "args": ["$HOME/src/dotfiles/cheatsheet.md"],
        "reveal": "always",
        "hide": "always",
        "show_summary": false,
        "show_command": false
    }
]
