# Claude Code local state that must NOT be committed. Scoped so it does NOT match
# the `claude/.claude/` stow package. Note: /.claude/settings.json IS tracked — it's
# the shared project permission allowlist for this repo, synced across machines.
# settings.local.json (per-machine personal overrides) stays ignored via the rule below.
/.claude/worktrees/

# Per-machine Claude Code local settings, wherever they appear (e.g. nvim/.config/nvim/.claude/).
# Kept explicit so it survives the root-anchoring above and on machines without a global gitignore.
**/.claude/settings.local.json

# Finder drops these on any visited directory; no global excludesfile is
# assumed (see the Claude comment above about machines without one).
.DS_Store

# Python bytecode cache, generated by running/compiling any .py file
# (e.g. fixtures/animal.py).
__pycache__/

# Compiled spell files — nvim regenerates them from the committed .add
# (automatically on the next zg, or manually via :mkspell! % on the .add).
*.spl

# iTerm2 live folder-sync plist — the repo tracks the deliberate
# "iTerm2 State.itermexport" snapshot instead (see README → iTerm2); this
# guards against someone re-enabling "Save changes to folder" and dirtying
# the repo on every quit.
iterm2/com.googlecode.iterm2.plist
