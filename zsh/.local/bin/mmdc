#!/usr/bin/env bash
# mmdc — shim rendering Mermaid via native-Rust `mmdr` (brew install mmdr, ~8 MB)
# instead of the official mermaid-cli (~1 GB headless Chromium). Named `mmdc` and
# stowed onto ~/.local/bin (ahead of homebrew on PATH) to shadow it, because
# snacks.image hardcodes the `mmdc` command. See plans/ghostty.md §6.
#
# snacks calls:  mmdc -i {src} -o {file} -b transparent -t {dark|neutral} -s {scale}
# mmdr's CLI differs (-i/-o/-e/-c/-w/-H), so translate below.
set -euo pipefail

src="" out="" theme="neutral"
while [ $# -gt 0 ]; do
  case "$1" in
    -i|--input)           src="$2";   shift 2 ;;
    -o|--output)          out="$2";   shift 2 ;;
    -t|--theme)           theme="$2"; shift 2 ;;
    -b|--backgroundColor) shift 2 ;;  # background comes from mmdr's theme/config
    -s|--scale)           shift 2 ;;  # mmdr's default size is crisp enough
    *)                    shift ;;    # ignore any other mermaid-cli flag
  esac
done

if [ -z "$src" ] || [ -z "$out" ]; then
  echo "mmdc(shim): missing -i <src> or -o <out>" >&2
  exit 2
fi

args=(-i "$src" -o "$out" -e png)

# Dark nvim background -> Dracula-matched themeVariables (mmdr themes via a JSON
# config, not -t) so diagrams blend in. Light/neutral uses mmdr's default.
if [ "$theme" = "dark" ]; then
  cfg="$(mktemp -t mmdc-dark.XXXXXX.json)"
  trap 'rm -f "$cfg"' EXIT
  cat > "$cfg" <<'JSON'
{"themeVariables":{"darkMode":true,"background":"#282a36","primaryColor":"#44475a","primaryTextColor":"#f8f8f2","primaryBorderColor":"#6272a4","lineColor":"#f8f8f2","secondaryColor":"#44475a","tertiaryColor":"#282a36","noteBkgColor":"#44475a","noteTextColor":"#f8f8f2"}}
JSON
  args+=(-c "$cfg")
fi

mmdr "${args[@]}"
