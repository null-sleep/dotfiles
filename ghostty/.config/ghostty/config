# Ghostty — the only terminal now. Stowed to ~/.config/ghostty/config.
# Ported from the old iTerm2 profile; iTerm2 itself was cut over and
# uninstalled 2026-07-15 — see plans/ghostty-followups.md.

# Font — matches the old iTerm2 profile (HackNFM-Regular 14).
font-family = Hack Nerd Font Mono
font-size = 14

# Follows macOS light/dark natively. Both names are Ghostty built-ins
# (`ghostty +list-themes` prints this Title Case) — the `theme` script only
# flips macOS, Ghostty recolors itself.
theme = light:Catppuccin Latte,dark:Dracula

# Window — started from the old iTerm2 profile (125x25), since tuned:
# slightly larger, tighter padding.
window-width = 130
window-height = 33
window-padding-x = 2
window-padding-y = 2

# Restore window/tab/split layout on relaunch, not just via macOS's own
# "reopen windows" toggle. See plans/ghostty-followups.md § 2.4.
window-save-state = always

# Tabs live in the titlebar row next to the traffic lights — no separate
# title-text strip. See plans/ghostty-followups.md § 2.8.
macos-titlebar-style = tabs

# Cursor — matches the old iTerm2 profile (bar, blinking). Default bar
# thickness reads as too thin; widen it.
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 2

# Hide the mouse pointer as soon as typing starts; it reappears on any
# mouse movement/click.
mouse-hide-while-typing = true

# Option-as-Meta on both sides, so nvim's <M-...> mappings work.
macos-option-as-alt = true

# No true "unlimited" scrollback option — go large instead.
scrollback-limit = 300000

# SSH shell integration: wraps the `ssh` command to forward env vars and
# auto-install Ghostty's terminfo on the remote host. Only works for
# interactive shell invocations of `ssh` (not scripts/cron/third-party
# tools like scp/rsync/git) — see https://ghostty.org/docs/features/ssh
shell-integration-features = ssh-env,ssh-terminfo

confirm-close-surface = false
quit-after-last-window-closed = true

# Off: Ghostty writes hard line breaks to the macOS pasteboard as NUL, not
# newline, so every multi-line selection pastes as one line (nvim shows the
# breaks as ^@). ⌘C is unaffected — only the copy-on-select path is. If
# re-enabling after an upstream fix, the value must be `clipboard`, not
# `true`: `true` prefers the selection clipboard, which pbpaste and other
# apps can't read, so nothing reaches the system clipboard at all.
# See plans/README.md → "Ghostty copy-on-select mangles multi-line copies".
copy-on-select = false

# Option+Backspace = delete-word-backwards. Required by pi: under the kitty
# keyboard protocol Ghostty reports the chord as a CSI u sequence pi doesn't
# read, so bind the legacy ESC DEL bytes explicitly.
# See https://pi.dev/docs/latest/terminal-setup
keybind = alt+backspace=text:\x1b\x7f

# No shift+enter binding here on purpose. It used to be `text:\n` (ported from
# iTerm2, for multi-line input in Claude Code / REPLs), but that swallows the
# chord and hands the app a bare linefeed — so pi and Claude Code can never see
# Shift+Enter as a distinct key. Both read it natively via CSI u now, as does
# nvim's terminal-mode <S-CR> map (lua/terminal.lua). pi's terminal-setup docs
# call out removing this mapping specifically; re-add it only under tmux.

# Test drive: system-wide show/hide for all Ghostty windows (not the
# quick-terminal dropdown). Needs macOS Accessibility permission granted to
# Ghostty on first load — see `global:` in `ghostty +show-config --docs`.
keybind = global:super+ctrl+t=toggle_visibility

# Everything else — splits, tabs, pane nav, word-jump, natural-text-editing —
# is a Ghostty macOS default and needs no config here; the iTerm2 export had
# no custom bindings for any of it. (Option+Arrow breaking specifically inside
# terminal nvim was a separate nvim-side issue — see keymaps.lua's <M-b>/<M-f>.)
