# Font (matches iTerm2: Hack Nerd Font Mono, size 15)
font_family      Hack Nerd Font Mono
font_size        15.0

# Window (matches iTerm2: 125x25)
remember_window_size  no
initial_window_width  125c
initial_window_height 25c
window_padding_width  4
hide_window_decorations titlebar-only
confirm_os_window_close 0

# Cursor (matches iTerm2: bar cursor)
cursor_shape beam

# macOS
macos_option_as_alt yes
macos_quit_when_last_window_closed yes

# Shell
shell_integration enabled

# Theme (override by creating ~/.config/kitty/current-theme.conf)
# To pick a theme interactively:  kitten themes
